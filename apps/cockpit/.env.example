# Point the cockpit at the API. This is the ONLY change needed to swap from the
# Prism mock to the real Worker:
#   mock        ->  http://localhost:4010
#   wrangler    ->  http://127.0.0.1:8787
#   deployed    ->  https://labmate.<your-subdomain>.workers.dev
VITE_API_BASE=http://localhost:4010

# Shared internal bearer token (LABMATE_INTERNAL_TOKEN). Sent on write routes.
# Reads are public; this is harmless on reads. Keep real tokens out of git.
VITE_API_TOKEN=dev-internal-token-0000000000000000
