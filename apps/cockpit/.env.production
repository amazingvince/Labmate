# Production build (vite build). The Worker serves this SPA same-origin, so the
# API is reached on a RELATIVE path — no CORS, no hardcoded host. Leave empty.
VITE_API_BASE=

# Writes (Approve / Deny / feedback / report / grade) require the internal bearer
# token. It would be embedded in the PUBLIC JS bundle, so it is intentionally left
# blank here (a read-only public deploy: reads work, writes return 401).
#
# To ship a fully-interactive demo, build with a rotatable/scoped token via either:
#   VITE_API_TOKEN=<token> npm run build        # one-off
#   echo 'VITE_API_TOKEN=<token>' > apps/cockpit/.env.production.local   # gitignored
VITE_API_TOKEN=
